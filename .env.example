# Секретный ключ Flask (генерируйте случайную строку!)
SECRET_KEY=your-secret-key-here-change-this-in-production

# URL базы данных (для Railway используется переменная DATABASE_URL автоматически)
# Локально: sqlite:///database/affiliate.db
# Production: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///database/affiliate.db

# Режим окружения
FLASK_ENV=production

# Порт (Railway устанавливает автоматически)
PORT=5000

# ===========================
# Email Configuration
# ===========================
# Настройте эти параметры для отправки email (восстановление пароля)

# SMTP сервер (Gmail, Mailgun, SendGrid и т.д.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Учетные данные SMTP
# Для Gmail: используйте App Password (не обычный пароль)
# Инструкция: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Отправитель (From address)
MAIL_DEFAULT_SENDER=noreply@affiliatebridge.com

# ===========================
# ETL Migration Configuration
# ===========================

# BigQuery Configuration
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=your-dataset-name
BIGQUERY_TABLE=events_table
BIGQUERY_CREDENTIALS_PATH=/path/to/service-account-key.json

# Apache Unomi Configuration
UNOMI_API_URL=http://localhost:8181
UNOMI_API_USERNAME=karaf
UNOMI_API_PASSWORD=karaf
UNOMI_SCOPE=default

# Migration Settings
MIGRATION_BATCH_SIZE=1000
MIGRATION_MAX_WORKERS=4
RATE_LIMIT_RPS=10

# Retry Settings
MAX_RETRIES=3
RETRY_WAIT_MULTIPLIER=2
RETRY_WAIT_MIN=1
RETRY_WAIT_MAX=60

# Checkpoint and Logging
CHECKPOINT_DIR=./etl_migration/checkpoints
CHECKPOINT_INTERVAL=1
LOG_DIR=./etl_migration/logs
LOG_LEVEL=INFO

# Incremental Sync Settings
SYNC_COLUMN=date_ev
